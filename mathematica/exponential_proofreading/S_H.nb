Cell[BoxData[{
 RowBox[{
  RowBox[{"Dcontrat", "[", "E_", "]"}], ":=", 
  RowBox[{"Log", "[", 
   FractionBox[
    RowBox[{"2.5", "*", 
     SuperscriptBox["10", "9"]}], 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"2.5", "*", "E"}], "]"}], "-", "1"}]], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dshape", "[", 
   RowBox[{"E_", ",", " ", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Log", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}], "*", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"2.5", "*", "E"}], "]"}], "-", "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"2.5", "*", 
            RowBox[{"(", 
             RowBox[{"x", "-", "1"}], ")"}], "*", "E"}], ")"}]}], "]"}]}], 
       ")"}]]}], "]"}], "-", 
   RowBox[{
    RowBox[{"(", 
     FractionBox["x", 
      RowBox[{"x", "-", "1"}]], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"2.5", "*", 
         RowBox[{"(", 
          RowBox[{"x", "-", "1"}], ")"}], "*", "E"}], ")"}], 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"(", 
          RowBox[{"2.5", "*", 
           RowBox[{"(", 
            RowBox[{"x", "-", "1"}], ")"}], "*", "E"}], ")"}], "]"}], "-", 
