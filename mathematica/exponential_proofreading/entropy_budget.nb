Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"from", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"\[Zeta]", "=", "0.5"}], ";", 
    RowBox[{"\[Beta]", "=", "2.3"}], ";", 
    RowBox[{"\[Sigma]", "=", "2.5"}], ";"}], "          ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Beta]", "*"}], ",", 
     RowBox[{"\[Sigma]", " ", 
      RowBox[{"measured", "/", "assumed"}]}]}], "*)"}], "\n", 
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"\[Zeta]", " ", "\[Beta]"}]}], "\n", 
   RowBox[{"L0", "=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"\[Beta]", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}], "]"}]}], 
   "                 ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"ln", " ", "L0"}], "=", 
     RowBox[{"\.bd", " ", "\[Beta]", "*", "\.b2", " ", "\[Sigma]\.b2"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Mu]0", "=", 
     RowBox[{"\[Beta]", " ", 
      RowBox[{"\[Sigma]", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]1", "=", 
     RowBox[{"\[Mu]0", "-", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"\[Sigma]", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nd", "=", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}], "/", 
      RowBox[{"CDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "cost", " ", "as", " ", "a", " ", "function", " ", "of", " ", 
      "fractional", " ", "reach", " ", "f"}], ",", 
     RowBox[{"in", " ", "units", " ", "of", " ", "ln", " ", "L0"}]}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"\[Beta]", " ", "\[Sigma]"}]}], ";"}], 
   "                              ", 
   RowBox[{"(*", " ", 
    RowBox[{"=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "Log", " ", "L0"}], "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mlog\[Phi]N", "[", "f_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Alpha]", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}], "+", 
        RowBox[{"\[Alpha]", " ", "\[Sigma]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Zeta]", "-", "f"}], ")"}], " ", "s"}], "]"}]}], "-", 
        RowBox[{"Log", "[", 
         RowBox[{"CDF", "[", 
          RowBox[{"nd", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Zeta]", "-", "f"}], ")"}], " ", "s"}]}], "]"}], 
         "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Beta]", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mlog\[Phi]N", "[", "f", "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"\[Zeta]", "^", "2"}], ",", 
         RowBox[{"f", "^", "2"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", "Gray"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Zeta]", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Zeta]", "^", "2"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<f  (reach)\>\"", ",", "\"\<-log \[Phi] / log L0\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<exact\>\"", ",", "\"\<max(\[Zeta]\.b2, f\.b2)\>\""}], 
       "}"}]}]}], "]"}]}]}]], "Input",
