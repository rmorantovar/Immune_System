Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "parameters"}]}], " ", "from", " ", 
     RowBox[{"data", "/", "heuristic"}], " ", 
     RowBox[{"pin", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Zeta]", "=", "0.5"}], ";", 
    RowBox[{"\[Alpha]", " ", "=", " ", "2.0"}], ";", 
    RowBox[{"\[Sigma]1", "=", 
     RowBox[{"Sqrt", "[", "5.", "]"}]}], ";", "   ", 
    RowBox[{"\[Sigma]2", "=", 
     RowBox[{"Sqrt", "[", "10.", "]"}]}]}], "      ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Sigma]", " ", "from", " ", "ln", " ", "L0"}], "=", 
     RowBox[{
      RowBox[{"\.bd", " ", "\[Beta]", "*", "\.b2", " ", "\[Sigma]\.b2"}], "\[TildeTilde]",
       "16.5"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]", "=", 
     RowBox[{"\[Alpha]", "/", "\[Zeta]"}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Mu]01", "=", 
     RowBox[{"\[Beta]", " ", 
      SuperscriptBox["\[Sigma]1", "2"]}]}], "  ", ";", " ", 
    RowBox[{"\[Mu]02", "=", 
     RowBox[{"\[Beta]", " ", 
      SuperscriptBox["\[Sigma]2", "2"]}]}], ";"}], "                ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"na\[IDoubleDot]ve", " ", "peak"}], ";", 
     RowBox[{
      RowBox[{"EVT", " ", "edge", " ", "at", " ", "a"}], "=", "0"}]}], "*)"}],
    "\n", 
   RowBox[{
    RowBox[{"\[Mu]11", "=", 
     RowBox[{"\[Mu]01", "-", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"\[Sigma]1", "^", "2"}]}]}]}], ";", "  ", 
    RowBox[{"\[Mu]12", "=", 
     RowBox[{"\[Mu]02", "-", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"\[Sigma]2", "^", "2"}]}]}]}], ";"}], "                      ", 
   RowBox[{"(*", 
    RowBox[{"tilted", " ", "mean", " ", 
     RowBox[{"(", 
      RowBox[{"w", "=", 
       RowBox[{"0", " ", "crossover"}]}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"lnL01", "=", 
     RowBox[{
      RowBox[{"\[Beta]", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"\[Sigma]1", "^", "2"}], "/", "2"}]}]}], ";", " ", 
    RowBox[{"lnL02", "=", 
     RowBox[{
      RowBox[{"\[Beta]", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"\[Sigma]2", "^", "2"}], "/", "2"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "building"}]}], " ", 
      RowBox[{"blocks", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nd", "=", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}], "/", 
      RowBox[{"CDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"w1", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "\[Mu]11"}], ")"}], "/", "\[Sigma]1"}]}], ";", " ", 
    RowBox[{
     RowBox[{"w2", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "\[Mu]12"}], ")"}], "/", "\[Sigma]2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"zp1", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "\[Mu]01"}], ")"}], "/", "\[Sigma]1"}]}], ";", " ", 
    RowBox[{
     RowBox[{"zp2", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "\[Mu]02"}], ")"}], "/", "\[Sigma]2"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"full", " ", "cost", " ", 
      RowBox[{"(", "dominance", ")"}], " ", "and", " ", "gate"}], "-", 
     RowBox[{"only", " ", "cost", " ", 
      RowBox[{"(", "eligibility", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mlog\[Phi]1", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"\[Sigma]1", "^", "2"}], "/", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Sigma]1", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"w1", "[", "a", "]"}], "]"}]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{"CDF", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"w1", "[", "a", "]"}]}], "]"}], "]"}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"mlog\[Phi]2", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"\[Sigma]2", "^", "2"}], "/", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Sigma]2", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"w2", "[", "a", "]"}], "]"}]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{"CDF", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"w2", "[", "a", "]"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gateKL1", "[", "a_", "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"CDF", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"zp1", "[", "a", "]"}]}], "]"}], "]"}]}]}], ";", "   ", 
    RowBox[{
     RowBox[{"gateKL2", "[", "a_", "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"CDF", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"zp2", "[", "a", "]"}]}], "]"}], "]"}]}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", "log"}], " ", "p_act"}]}], ",", "exact"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tiltKL1", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"\[Sigma]1", "^", "2"}], "/", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Sigma]1", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"w1", "[", "a", "]"}], "]"}]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"nd", ",", 
          RowBox[{"w1", "[", "a", "]"}]}], "]"}], "/", 
        RowBox[{"CDF", "[", 
         RowBox[{"nd", ",", 
          RowBox[{"zp1", "[", "a", "]"}]}], "]"}]}], "]"}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"tiltKL2", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"\[Sigma]2", "^", "2"}], "/", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Sigma]2", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"w2", "[", "a", "]"}], "]"}]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"nd", ",", 
          RowBox[{"w2", "[", "a", "]"}]}], "]"}], "/", 
        RowBox[{"CDF", "[", 
         RowBox[{"nd", ",", 
          RowBox[{"zp2", "[", "a", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mlog\[Phi]1", "[", "y", "]"}], ",", 
       RowBox[{"gateKL1", "[", "y", "]"}], ",", " ", 
       RowBox[{"tiltKL1", "[", "y", "]"}], ",", 
       RowBox[{
        RowBox[{"\[Alpha]", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"\[Sigma]1", "^", "2"}], "/", "2"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "16"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
