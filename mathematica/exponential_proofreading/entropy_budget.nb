Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "parameters"}]}], " ", "from", " ", 
     RowBox[{"data", "/", "heuristic"}], " ", 
     RowBox[{"pin", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Zeta]", "=", "0.5"}], ";", 
    RowBox[{"\[Beta]", "=", "2.3"}], ";", 
    RowBox[{"\[Sigma]", "=", "2.5"}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Sigma]", " ", "from", " ", "ln", " ", "L0"}], "=", 
     RowBox[{
      RowBox[{"\.bd", " ", "\[Beta]", "*", "\.b2", " ", "\[Sigma]\.b2"}], "\[TildeTilde]",
       "16.5"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", 
     RowBox[{"\[Zeta]", " ", "\[Beta]"}]}], ";"}], "\n", 
   RowBox[{"\[Mu]0", "=", 
    RowBox[{"\[Beta]", " ", 
     RowBox[{"\[Sigma]", "^", "2"}]}]}], "                           ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"na\[IDoubleDot]ve", " ", "peak"}], ";", 
     RowBox[{
      RowBox[{"EVT", " ", "edge", " ", "at", " ", "a"}], "=", "0"}]}], "*)"}],
    "\n", 
   RowBox[{
    RowBox[{"\[Mu]1", "=", 
     RowBox[{"\[Mu]0", "-", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"\[Sigma]", "^", "2"}]}]}]}], ";"}], "                       ", 
   RowBox[{"(*", 
    RowBox[{"tilted", " ", "mean", " ", 
     RowBox[{"(", 
      RowBox[{"w", "=", 
       RowBox[{"0", " ", "crossover"}]}], ")"}]}], "*)"}], "\n", 
   RowBox[{"lnL0", "=", 
    RowBox[{
     RowBox[{"\[Beta]", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "building"}]}], " ", 
      RowBox[{"blocks", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nd", "=", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}], "/", 
      RowBox[{"CDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"w", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "\[Mu]1"}], ")"}], "/", "\[Sigma]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"zp", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "\[Mu]0"}], ")"}], "/", "\[Sigma]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"full", " ", "cost", " ", 
      RowBox[{"(", "dominance", ")"}], " ", "and", " ", "gate"}], "-", 
     RowBox[{"only", " ", "cost", " ", 
      RowBox[{"(", "eligibility", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mlog\[Phi]", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Sigma]", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"w", "[", "a", "]"}], "]"}]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{"CDF", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"w", "[", "a", "]"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gateKL", "[", "a_", "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"CDF", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"zp", "[", "a", "]"}]}], "]"}], "]"}]}]}], ";"}], "     ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", "log"}], " ", "p_act"}]}], ",", "exact"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tiltKL", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Sigma]", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"w", "[", "a", "]"}], "]"}]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"nd", ",", 
          RowBox[{"w", "[", "a", "]"}]}], "]"}], "/", 
        RowBox[{"CDF", "[", 
         RowBox[{"nd", ",", 
          RowBox[{"zp", "[", "a", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mlog\[Phi]", "[", "y", "]"}], ",", 
       RowBox[{"gateKL", "[", "y", "]"}], ",", " ", 
       RowBox[{"tiltKL", "[", "y", "]"}], ",", 
       RowBox[{
        RowBox[{"\[Alpha]", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "16"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", 
          RowBox[{"Darker", "@", "Green"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", 
          RowBox[{"Darker", "@", "Red"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", "Gray"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Filling", "->", 
      RowBox[{"{", 
       RowBox[{"1", "->", 
        RowBox[{"{", "2", "}"}]}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"shaded", " ", "gap"}], "=", 
       RowBox[{"tilt", " ", "term"}]}], "*)"}], 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1.25", " ", "lnL0"}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalDelta]G\), \(f\)]\)  (k_BT)\
\>\"", ",", "\"\<nats\>\""}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Mu]1", ",", "\[Mu]0"}], "}"}], ",", 
        RowBox[{"{", "lnL0", "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<-log \[Phi] (total) \>\"", 
        ",", "\"\<-log p_act (eligibility)\>\"", 
        ",", "\"\<tilt (dominance)\>\"", ",", 
        " ", "\"\<tilt plateau \[Zeta]\.b2 ln L0\>\""}], "}"}]}]}], 
    "]"}]}]}]], "Input",
