 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]1", "[", "n_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", 
     RowBox[{"n", "^", "2"}], " ", 
