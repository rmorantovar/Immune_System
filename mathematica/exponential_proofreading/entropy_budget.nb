Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"parameters", "--"}]}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]", "=", "2.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L0", "=", 
     RowBox[{"10", "^", "7."}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Zeta]", "=", "0.5"}], ";"}], "\n", 
   RowBox[{"\[Mu]0", "=", 
    RowBox[{"\[Sigma]", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", 
       RowBox[{"Log", "[", "L0", "]"}]}], "]"}]}]}], "     ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"na\[IDoubleDot]ve", " ", "peak"}], ";", 
     RowBox[{
      RowBox[{"EVT", " ", "edge", " ", "sits", " ", "at", " ", "a"}], "=", 
      "0"}]}], "*)"}], "\n", 
   RowBox[{"\[Beta]", "=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", 
       RowBox[{"Log", "[", "L0", "]"}]}], "]"}], "/", "\[Sigma]"}]}], "     ", 
   RowBox[{"(*", 
    RowBox[{"entropy", " ", "slope", " ", "\[Beta]", "*"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", 
     RowBox[{"\[Zeta]", " ", "\[Beta]"}]}], ";"}], "                    ", 
   RowBox[{"(*", 
    RowBox[{"one", " ", "round", " ", "of", " ", "EP"}], "*)"}], "\n", 
   RowBox[{"\[Mu]1", "=", 
    RowBox[{"\[Mu]0", "-", 
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"\[Sigma]", "^", "2"}]}]}]}], "             ", 
   RowBox[{"(*", 
    RowBox[{"tilted", " ", "mean"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "building"}]}], " ", 
      RowBox[{"blocks", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nd", "=", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}], "/", 
      RowBox[{"CDF", "[", 
       RowBox[{"nd", ",", "x"}], "]"}]}]}], ";"}], "          ", 
   RowBox[{"(*", 
    RowBox[{"inverse", " ", "Mills", " ", "ratio"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"w", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "\[Mu]1"}], ")"}], "/", "\[Sigma]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"mlog\[Phi]", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Sigma]", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"w", "[", "a", "]"}], "]"}]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{"CDF", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"w", "[", "a", "]"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "two"}]}], " ", "limiting", " ", 
      RowBox[{"references", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tiltPlateau", "=", 
     RowBox[{
      RowBox[{"\[Alpha]", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"\[Sigma]", "^", "2"}], "/", "2"}]}]}], ";"}], 
   "                  ", 
   RowBox[{"(*", 
    RowBox[{"slack", "-", 
     RowBox[{"gate", " ", "limit"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gateAsymp", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "-", "\[Mu]0"}], ")"}], "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}]}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"deep", "-", 
      RowBox[{"cut", " ", "limit"}]}], ",", 
     RowBox[{
      RowBox[{"valid", " ", "for", " ", "a"}], "<", "\[Mu]0"}]}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"plot", "--"}]}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mlog\[Phi]", "[", "a", "]"}], ",", "tiltPlateau", ",", 
       RowBox[{"gateAsymp", "[", "a", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", 
       RowBox[{"-", "1"}], ",", "16"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", "Gray"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Dotted", ",", "Gray"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1.05", " ", 
         RowBox[{"Log", "[", "L0", "]"}]}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<a  (gate position)\>\"", 
        ",", "\"\<-log \[Phi] = D_KL\>\""}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Mu]1", ",", "\[Mu]0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Log", "[", "L0", "]"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<-log \[Phi]\>\"", 
        ",", "\"\<tilt plateau \[Alpha]\.b2\[Sigma]\.b2/2\>\"", 
        ",", "\"\<gate asymptote (a-\[Mu]\:2080)\.b2/2\[Sigma]\.b2\>\""}], 
       "}"}]}]}], "]"}]}]}]], "Input",
