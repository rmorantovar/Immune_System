   RowBox[{"abbreviating", " ", "your", " ", 
    RowBox[{"exprs", ":"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"q1", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[CapitalOmega]0", "[", "x", "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Alpha]"}], " ", "x"}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"\[Sigma]1", "^", "2"}], " ", 
       RowBox[{"\[Alpha]", "^", "2"}]}], "+", 
      RowBox[{"\[Alpha]", " ", "\[Mu]01"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"q2", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"q1", "[", "x", "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[Alpha]"}], " ", "x"}], "]"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}], " ", 
        RowBox[{"\[Sigma]1", "^", "2"}], " ", 
        RowBox[{"\[Alpha]", "^", "2"}]}], "+", 
       RowBox[{"\[Alpha]", " ", "\[Mu]11"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fill1", "=", 
    RowBox[{"LogPlot", "[", 
     RowBox[{
      RowBox[{"q1", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "0.01"}], ",", "18"}], "}"}], ",", 
      RowBox[{"Filling", "->", "Axis"}], ",", 
      RowBox[{"FillingStyle", "->", 
