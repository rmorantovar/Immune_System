Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Gamma]", " ", "=", " ", ".01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", 
           SubscriptBox["\[Lambda]", "A"]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              SubscriptBox["\[Lambda]", "A"], "*", "t"}], "]"}], "-", "1"}], 
           ")"}]}], "-", 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            SubscriptBox["\[Lambda]", "A"], "+", "\[Gamma]"}]], 
