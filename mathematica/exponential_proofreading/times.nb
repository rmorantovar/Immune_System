             RowBox[{
              RowBox[{"-", "\[Gamma]"}], " ", "*", "t"}], "]"}]}], ")"}]}]}], 
        ")"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             SubscriptBox["\[Lambda]", "A"], "t"}]], "+", 
