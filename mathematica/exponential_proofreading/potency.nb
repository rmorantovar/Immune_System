Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mu0", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmaE", " ", "=", " ", 
     RowBox[{"Sqrt", "[", "6.", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barz0", " ", "=", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "mu0"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"sigmaE", "^", "2"}], "/", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barz", "[", "x_", "]"}], ":=", 
    RowBox[{"barz0", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"sigmaE", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "*", "x"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        SuperscriptBox["10", "10"], 
        RowBox[{"barz", "[", "x", "]"}]], ",", " ", 
       FractionBox[
        SuperscriptBox["10", "12"], 
        RowBox[{"barz", "[", "x", "]"}]]}], "}"}], ",", " ", 
     RowBox[{"{", 
