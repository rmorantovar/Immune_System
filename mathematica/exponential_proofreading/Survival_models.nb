         RowBox[{"Thickness", "[", "0.003", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Thick"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", "Thick", ",", " ", "Dashed"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Darker", "[", "Blue", "]"}], ",", "Thick", ",", " ", 
         "Dashed"}], "}"}]}], "}"}]}], ",", "\n", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<n=2\>\"", ",", "\"\<n=4\>\"", ",", "\"\<n=8\>\"", 
       ",", "\"\<n=20\>\"", ",", 
