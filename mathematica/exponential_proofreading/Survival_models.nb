Cell["\<\
2. Main Comparison: Mean-Field vs Discrete Hill vs Sharp Threshold\
\>", "Section",ExpressionUUID->"a4720a00-51bd-423a-96e4-840df4a77dfb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"plot1", " ", "=", " ", 
  RowBox[{"LogPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PbMF", "[", 
        RowBox[{
        "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
        "]"}], ",", 
       RowBox[{"PbDisc", "[", 
        RowBox[{
        "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
        "]"}], ",", 
       RowBox[{"PbSharp", "[", 
        RowBox[{"EE", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
        "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"EE", ",", 
      RowBox[{"-", "2"}], ",", 
      RowBox[{"Emax", "+", "4"}]}], "}"}], ",", "\n", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Blue", ",", "Thick"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Red", ",", "Thick", ",", "Dashed"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Darker", "[", "Green", "]"}], ",", "Thick", ",", 
         "DotDashed"}], "}"}]}], "}"}]}], ",", "\n", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Mean-field Hill; n=\>\"", "<>", " ", 
        RowBox[{"ToString", "[", "n0", "]"}]}], ",", 
       RowBox[{"\"\<Discrete Hill; n=\>\"", "<>", " ", 
