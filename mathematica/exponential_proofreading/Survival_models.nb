Notebook[{

Cell[CellGroupData[{
Cell["Discrete vs Mean-Field Threshold Models", "Title",ExpressionUUID->"d13ced98-9405-42dd-a04f-260b1ed0e239"],

Cell["Visualization of affinity scaling results", "Subtitle",ExpressionUUID->"69b4a864-b4a1-4b85-a9a6-9b4cba0dd018"],

Cell[CellGroupData[{

Cell["1. Parameters and Core Functions", "Section",ExpressionUUID->"a057d1a2-6861-4318-ad01-5ba3c89566f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Parameters", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]0", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Theta]0", "=", "6"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c0", "=", 
     SuperscriptBox["10", "1"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Emax", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n0", " ", "=", " ", "3"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Hill", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"x_", ",", "\[Theta]_", ",", "n_"}], "]"}], ":=", 
     FractionBox[
      SuperscriptBox["x", "n"], 
      RowBox[{
       SuperscriptBox["x", "n"], "+", 
       SuperscriptBox["\[Theta]", "n"]}]]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Poisson", " ", "PMF"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"poiss", "[", 
      RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      SuperscriptBox["x", "n"], 
      FractionBox[
       RowBox[{"Exp", "[", 
        RowBox[{"-", "x"}], "]"}], 
       RowBox[{"Factorial", "[", "n", "]"}]]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.98205963303511*^9, 3.982059633496047*^9}, {
   3.982059753034623*^9, 3.982059757108451*^9}, 3.982059809493224*^9, {
   3.982059977442417*^9, 3.982060020777567*^9}, 3.982060098820323*^9, 
   3.982060174405224*^9, {3.982060330705246*^9, 3.982060334447249*^9}, {
   3.9820604412041073`*^9, 3.982060447663405*^9}, {3.982060651140677*^9, 
   3.9820606569968233`*^9}, {3.982060734698761*^9, 3.9820607388194323`*^9}, {
   3.9820607717556667`*^9, 3.982060788883006*^9}, 3.982061604295177*^9, {
   3.9820620718492737`*^9, 3.982062095797771*^9}, {3.98206253083422*^9, 
   3.9820625319485283`*^9}, 3.982062589823989*^9, 3.982062648240027*^9, 
   3.982064462724996*^9, 3.982065896013997*^9},
 CellLabel->
  "In[890]:=",ExpressionUUID->"4ad954f5-34d4-4429-8c33-6db863b1328b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Mean", "-", 
    RowBox[{"field", " ", "Pb"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PbMF", "[", 
      RowBox[{
      "EE_", ",", "n_", ",", "\[Theta]_", ",", "\[Gamma]_", ",", "c_"}], 
      "]"}], ":=", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], " ", 
        RowBox[{"H", "[", 
         RowBox[{
          RowBox[{"c", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SuperscriptBox["\[ExponentialE]", "EE"]}], ")"}], 
            RowBox[{"-", "1"}]]}], ",", "\[Theta]", ",", "n"}], "]"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Discrete", " ", "Hill", " ", "Pb", " ", 
     RowBox[{"(", 
      RowBox[{"truncated", " ", "sum"}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PbDisc", "[", 
      RowBox[{
      "EE_", ",", "n_", ",", "\[Theta]_", ",", "\[Gamma]_", ",", "c_", ",", 
       RowBox[{"kmax_", ":", "20"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Pi]", "=", 
         RowBox[{"c", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["\[ExponentialE]", "EE"]}], ")"}], 
           RowBox[{"-", "1"}]]}]}], "}"}], ",", 
       RowBox[{"1", "-", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"poiss", "[", 
            RowBox[{"k", ",", "\[Pi]"}], "]"}], 
           RowBox[{"(", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "\[Gamma]"}], " ", 
              RowBox[{"H", "[", 
               RowBox[{"k", ",", "\[Theta]", ",", "n"}], "]"}]}], "]"}], 
            ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "kmax"}], "}"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Discrete", " ", "sharp", " ", "threshold", " ", "Pb"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PbSharp", "[", 
      RowBox[{"EE_", ",", "\[Theta]_", ",", "\[Gamma]_", ",", "c_", ",", 
       RowBox[{"kmax_", ":", "40"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Pi]", "=", 
         RowBox[{"c", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["\[ExponentialE]", "EE"]}], ")"}], 
           RowBox[{"-", "1"}]]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "\[Gamma]"}], "]"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"poiss", "[", 
            RowBox[{"k", ",", "\[Pi]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "\[Theta]", ",", "kmax"}], "}"}]}], "]"}], 
         ")"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.982059838169973*^9, 3.982059855632649*^9}, {
   3.9820598995613956`*^9, 3.982059927849291*^9}, 3.982060068658671*^9, {
   3.982060153759691*^9, 3.982060159807618*^9}, {3.98206081816575*^9, 
   3.9820608688900957`*^9}, {3.9820609516232967`*^9, 
   3.9820609607961187`*^9}, {3.982060991459684*^9, 3.982061022129735*^9}, {
   3.9820610747029257`*^9, 3.982061108216814*^9}, 3.9820611404467287`*^9, {
   3.9820611991773148`*^9, 3.982061214064846*^9}, {3.982061406087369*^9, 
   3.982061406475758*^9}, {3.9820614660973577`*^9, 3.982061489277999*^9}, {
   3.982061548173738*^9, 3.98206155988798*^9}, {3.982061611798101*^9, 
   3.9820616288707523`*^9}, {3.982061667925352*^9, 3.982061685435379*^9}, {
   3.9820617434956493`*^9, 3.982061747826564*^9}, {3.982061896624683*^9, 
   3.982061909299437*^9}},
 CellLabel->
