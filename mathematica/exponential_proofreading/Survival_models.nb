Cell[CellGroupData[{

Cell["3. Slope Comparison: Effective Exponent", "Section",ExpressionUUID->"56d9037f-c520-4f36-ac16-eb238262ec2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Local", " ", "slope"}], " ", "=", " ", 
    RowBox[{"-", 
     RowBox[{"d", " ", 
      RowBox[{"log", 
       RowBox[{"(", "Pb", ")"}]}], "/", "dE"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"slopeMF", "[", "EE_", "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"PbMF", "[", 
         RowBox[{
         "e", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
         "]"}], "]"}], ",", "e"}], "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"slopeDisc", "[", "EE_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"PbDisc", "[", 
           RowBox[{
            RowBox[{"EE", "+", "0.001"}], ",", "n0", ",", "\[Theta]0", ",", 
            "\[Gamma]0", ",", "c0"}], "]"}], "]"}], "-", 
         RowBox[{"Log", "[", 
          RowBox[{"PbDisc", "[", 
           RowBox[{
           "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
           "]"}], "]"}]}], ")"}]}], "/", "0.001"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"slopeSharp", "[", "EE_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"PbSharp", "[", 
           RowBox[{
            RowBox[{"EE", "+", "0.001"}], ",", "\[Theta]0", ",", "\[Gamma]0", 
            ",", "c0"}], "]"}], "]"}], "-", 
         RowBox[{"Log", "[", 
          RowBox[{"PbSharp", "[", 
           RowBox[{"EE", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
           "]"}], "]"}]}], ")"}]}], "/", "0.001"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9820627649958878`*^9, 3.98206276822675*^9}, {
  3.98206442400401*^9, 3.982064428309729*^9}},
 CellLabel->
  "In[901]:=",ExpressionUUID->"50849338-b2d3-4b93-9c3f-742fb1f2f52b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"slopeMF", "[", "EE", "]"}], "/.", 
      RowBox[{"e", "\[Rule]", "EE"}]}], ",", 
     RowBox[{"slopeDisc", "[", "EE", "]"}], ",", 
     RowBox[{"slopeSharp", "[", "EE", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"EE", ",", 
     RowBox[{"-", "2"}], ",", 
     RowBox[{"Emax", "+", "4"}]}], "}"}], ",", "\n", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Thick"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Thick", ",", "Dashed"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Darker", "[", "Green", "]"}], ",", "Thick", ",", 
        "DotDashed"}], "}"}]}], "}"}]}], ",", "\n", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Mean-field Hill\>\"", ",", "\"\<Discrete Hill\>\"", 
      ",", "\"\<Discrete sharp\>\""}], "}"}]}], ",", "\n", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Dashed", ",", "Gray", ",", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "n0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}], ",", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}], ",", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Theta]0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}]}], "}"}]}], ",", "\n", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Affinity E\>\"", 
      ",", "\"\<Effective exponent  -d log(\!\(\*SubscriptBox[\(P\), \
\(b\)]\))/dE\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<Slope convergence (dashed gray: n=n0 and \
\[Theta]=\[Theta]0)\>\""}], ",", "\n", 
   RowBox[{"ImageSize", "\[Rule]", "500"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"\[Theta]0", "+", "2"}]}], "}"}]}]}], "]"}]], "Input",
