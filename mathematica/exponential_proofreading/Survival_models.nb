Cell["3. Slope Comparison: Effective Exponent", "Section",ExpressionUUID->"56d9037f-c520-4f36-ac16-eb238262ec2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Local", " ", "slope"}], " ", "=", " ", 
    RowBox[{"-", 
     RowBox[{"d", " ", 
      RowBox[{"log", 
       RowBox[{"(", "Pb", ")"}]}], "/", "dE"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"slopeMF", "[", "EE_", "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"PbMF", "[", 
         RowBox[{
         "e", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
         "]"}], "]"}], ",", "e"}], "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"slopeDisc", "[", "EE_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"PbDisc", "[", 
           RowBox[{
            RowBox[{"EE", "+", "0.01"}], ",", "n0", ",", "\[Theta]0", ",", 
            "\[Gamma]0", ",", "c0"}], "]"}], "]"}], "-", 
         RowBox[{"Log", "[", 
          RowBox[{"PbDisc", "[", 
           RowBox[{
           "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
           "]"}], "]"}]}], ")"}]}], "/", "0.01"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"slopeSharp", "[", "EE_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"PbSharp", "[", 
           RowBox[{
            RowBox[{"EE", "+", "0.01"}], ",", "\[Theta]0", ",", "\[Gamma]0", ",",
             "c0"}], "]"}], "]"}], "-", 
         RowBox[{"Log", "[", 
          RowBox[{"PbSharp", "[", 
           RowBox[{"EE", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
