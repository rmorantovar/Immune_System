Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Mean", "-", 
    RowBox[{"field", " ", "Pb"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PbMF", "[", 
      RowBox[{
      "EE_", ",", "n_", ",", "\[Theta]_", ",", "\[Gamma]_", ",", "c_"}], 
      "]"}], ":=", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], " ", 
        RowBox[{"H", "[", 
         RowBox[{
          RowBox[{"c", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SuperscriptBox["\[ExponentialE]", "EE"]}], ")"}], 
            RowBox[{"-", "1"}]]}], ",", "\[Theta]", ",", "n"}], "]"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Discrete", " ", "Hill", " ", "Pb", " ", 
     RowBox[{"(", 
      RowBox[{"truncated", " ", "sum"}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PbDisc", "[", 
      RowBox[{
      "EE_", ",", "n_", ",", "\[Theta]_", ",", "\[Gamma]_", ",", "c_", ",", 
       RowBox[{"kmax_", ":", "50"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Pi]", "=", 
         RowBox[{"c", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["\[ExponentialE]", "EE"]}], ")"}], 
           RowBox[{"-", "1"}]]}]}], "}"}], ",", 
       RowBox[{"1", "-", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"poiss", "[", 
            RowBox[{"k", ",", "\[Pi]"}], "]"}], 
           RowBox[{"(", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "\[Gamma]"}], " ", 
              RowBox[{"H", "[", 
               RowBox[{"k", ",", "\[Theta]", ",", "n"}], "]"}]}], "]"}], 
            ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "kmax"}], "}"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Discrete", " ", "sharp", " ", "threshold", " ", "Pb", " ", "\n", 
       RowBox[{"PbSharp", "[", 
        RowBox[{"EE_", ",", "\[Theta]_", ",", "\[Gamma]_", ",", "c_", ",", 
         RowBox[{"kmax_", ":", "40"}]}], "]"}]}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Pi]", "=", 
          RowBox[{"c", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SuperscriptBox["\[ExponentialE]", "EE"]}], ")"}], 
            RowBox[{"-", "1"}]]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", "\[Gamma]"}], "]"}]}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"poiss", "[", 
             RowBox[{"k", ",", "\[Pi]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "\[Theta]", ",", "kmax"}], "}"}]}], "]"}], 
          ")"}]}]}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PbSharp", "[", 
      RowBox[{"EE_", ",", "\[Theta]_", ",", "\[Gamma]_", ",", "c_", ",", 
       RowBox[{"kmax_", ":", "50"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Pi]", "=", 
         RowBox[{"c", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["\[ExponentialE]", "EE"]}], ")"}], 
           RowBox[{"-", "1"}]]}]}], "}"}], ",", 
       RowBox[{"(", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"poiss", "[", 
           RowBox[{"k", ",", "\[Pi]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "\[Theta]", ",", "kmax"}], "}"}]}], "]"}], 
        ")"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.982059838169973*^9, 3.982059855632649*^9}, {
