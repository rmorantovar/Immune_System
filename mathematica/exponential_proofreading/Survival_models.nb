Cell[CellGroupData[{

Cell["\<\
2. Main Comparison: Mean-Field vs Discrete Hill vs Sharp Threshold\
\>", "Section",ExpressionUUID->"a4720a00-51bd-423a-96e4-840df4a77dfb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PbMF", "[", 
       RowBox[{
       "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
       "]"}], ",", 
      RowBox[{"PbDisc", "[", 
       RowBox[{
       "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
       "]"}], ",", 
      RowBox[{"PbSharp", "[", 
       RowBox[{"EE", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], "]"}]}],
      "}"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"EE", ",", 
     RowBox[{"-", "2"}], ",", 
     RowBox[{"Emax", "+", "4"}]}], "}"}], ",", "\n", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Thick"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Thick", ",", "Dashed"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Darker", "[", "Green", "]"}], ",", "Thick", ",", 
        "DotDashed"}], "}"}]}], "}"}]}], ",", "\n", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Mean-field Hill (n=3)\>\"", 
      ",", "\"\<Discrete Hill (n=3)\>\"", 
      ",", "\"\<Discrete sharp (\[Theta]=6)\>\""}], "}"}]}], ",", "\n", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<E\>\"", ",", "\"\<\!\(\*SubscriptBox[\(P\), \(b\)]\)\>\""}],
      "}"}]}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<Affinity scaling comparison (\[Theta]=6, \[Gamma]=1, \
c=10)\>\""}], ",", "\n", 
   RowBox[{"PlotRange", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "500"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Affinity E\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(P\), \(b\)]\)\>\""}], "}"}]}]}], 
  "]"}]], "Input",
