Cell["6. Reference Slopes Overlay", "Section",ExpressionUUID->"8b09660e-621a-4c2f-8e2f-16e82599aca1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"plot1", " ", "=", " ", 
  RowBox[{"LogPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PbMF", "[", 
       RowBox[{
       "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
       "]"}], ",", 
      RowBox[{"PbDisc", "[", 
       RowBox[{
       "EE", ",", "n0", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
       "]"}], ",", 
      RowBox[{"PbSharp", "[", 
       RowBox[{"EE", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], "]"}], ",",
       "\n", 
      RowBox[{"(*", " ", 
       RowBox[{"Reference", " ", "lines"}], " ", "*)"}], "\n", 
      RowBox[{"10", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "n0"}], " ", "EE"}]]}], ",", " ", 
      RowBox[{".5", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", "EE"}]]}], ",", 
      RowBox[{"800", 
