         RowBox[{"EE", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], "]"}],
         ",", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "EE"}], "]"}], ",", " ", 
        RowBox[{"10", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Theta]0"}], "*", "EE"}], "]"}]}]}], "}"}]}], "]"}],
     "]"}], ",", 
   RowBox[{"{", 
