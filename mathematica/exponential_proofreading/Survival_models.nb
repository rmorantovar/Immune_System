Cell[CellGroupData[{

Cell["4. Convergence: Discrete Hill \[Rule] Sharp Threshold as n \[Rule] \
\[Infinity]", "Section",ExpressionUUID->"d9675a10-d437-4fbe-845a-\
c3511e365886"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"plot3", " ", "=", " ", 
  RowBox[{"LogPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"PbDisc", "[", 
          RowBox[{
          "EE", ",", "n", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "4", ",", "8", ",", "20"}], "}"}]}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PbSharp", "[", 
          RowBox[{"EE", ",", "\[Theta]0", ",", "\[Gamma]0", ",", "c0"}], 
          "]"}], ",", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "EE"}], "]"}], ",", " ", 
         RowBox[{"10", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Theta]0"}], "*", "EE"}], "]"}]}]}], "}"}]}], 
      "]"}], "]"}], ",", 
