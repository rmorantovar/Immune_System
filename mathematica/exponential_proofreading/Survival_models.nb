Cell["5. Non-Commutativity: Crossover Scale", "Section",ExpressionUUID->"d0803235-8f67-4209-adc4-d4c44654c5f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Show", " ", "the", " ", "k"}], "=", 
    RowBox[{"1", " ", "and", " ", "k"}], "=", 
    RowBox[{"\[Theta]", " ", "contributions", " ", "separately"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"term1", "[", 
      RowBox[{"EE_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Pi]", "=", 
         RowBox[{"c0", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", "EE"}]]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"poiss", "[", 
         RowBox[{"1", ",", "\[Pi]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Gamma]0"}], " ", 
            RowBox[{"H", "[", 
             RowBox[{"1", ",", "\[Theta]0", ",", "n"}], "]"}]}], "]"}]}], 
         ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"termTheta", "[", 
      RowBox[{"EE_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Pi]", "=", 
         RowBox[{"c0", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", "EE"}]]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"poiss", "[", 
         RowBox[{"\[Theta]0", ",", "\[Pi]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Gamma]0"}], " ", 
            RowBox[{"H", "[", 
             RowBox[{"\[Theta]0", ",", "\[Theta]0", ",", "n"}], "]"}]}], 
           "]"}]}], ")"}]}]}], "]"}]}], ";"}]}]}]], "Input",
